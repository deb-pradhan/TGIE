# TGIE /start enquiry form -> POST /api/enquiry (app/api/enquiry/route.ts)
# Copy to .env.local (dev) or set these in the hosting dashboard (prod). Server-only: never prefix with NEXT_PUBLIC_.
# Without RESEND_API_KEY + ENQUIRY_TO_EMAIL the API answers 503 "not_configured" and the form falls back to
# a copy-message / mailto panel, so nothing is lost but nothing is delivered either.
# REQUIRED FOR PRODUCTION: set RESEND_API_KEY, ENQUIRY_TO_EMAIL and NEXT_PUBLIC_CONTACT_EMAIL. Without the
# first two no enquiry is ever delivered; without the third the fallback panel can only offer copy-and-call.

# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered. Comma-separate to send to several people.
ENQUIRY_TO_EMAIL=
# Optional. A sender on a domain verified in Resend, e.g. "TGIE Website <enquiries@yourdomain.com>".
# Defaults to Resend's test sender (onboarding@resend.dev), which only delivers to your own Resend account email.
ENQUIRY_FROM_EMAIL=

# PUBLIC (shipped to the browser). The visible contact email shown on /start and used for the mailto fallback.
# Required for production. If left empty the mailto link and email line are hidden, and the fallback copy
# only offers "copy it and call us" (phone comes from content/site.ts).
NEXT_PUBLIC_CONTACT_EMAIL=

# PUBLIC. Google Analytics 4 measurement ID (loaded in production builds only). Defaults to the TGIE property
# in lib/analytics.ts, so only set this to point a staging deploy at a different property.
NEXT_PUBLIC_GA_ID=
