# TGIE /start enquiry form: there is no server-side mail. Submitting opens the visitor's own email app
# (mailto:) with the message pre-filled, addressed to NEXT_PUBLIC_CONTACT_EMAIL.
# Copy to .env.local (dev) or set in the hosting dashboard (prod). NEXT_PUBLIC_ values are baked in at build time.

# PUBLIC (shipped to the browser). The contact email: shown on /start and the footer, and the recipient of the /start form's mailto.
# Required for production. If left empty the form can only offer "copy it and call us"
# (phone comes from content/site.ts) and no email is shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=

# PUBLIC. Google Analytics 4 measurement ID (loaded in production builds only). Defaults to the TGIE property
# in lib/analytics.ts, so only set this to point a staging deploy at a different property.
NEXT_PUBLIC_GA_ID=
