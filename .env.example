# TGIE /start enquiry form -> POST /api/enquiry (app/api/enquiry/route.ts)
# Copy to .env.local (dev) or set these in the hosting dashboard (prod). Server-only: never prefix with NEXT_PUBLIC_.
# Without RESEND_API_KEY + ENQUIRY_TO_EMAIL the API answers 503 "not_configured" and the form falls back to
# a copy-message / mailto panel, so nothing is lost but nothing is delivered either.

# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered. Comma-separate to send to several people.
ENQUIRY_TO_EMAIL=
# Optional. A sender on a domain verified in Resend, e.g. "TGIE Website <enquiries@yourdomain.com>".
# Defaults to Resend's test sender (onboarding@resend.dev), which only delivers to your own Resend account email.
ENQUIRY_FROM_EMAIL=

# Optional and PUBLIC (shipped to the browser). The visible contact email used for the mailto fallback.
# Leave empty to hide the mailto link (copy-message and phone are still offered).
NEXT_PUBLIC_CONTACT_EMAIL=
